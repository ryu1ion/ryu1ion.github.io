<div class="ambient" aria-hidden="true">
  <canvas class="ambient__stars" data-starfield></canvas>
  <div class="ambient__grid"></div>
  <div class="ambient__aurora ambient__aurora--one"></div>
  <div class="ambient__aurora ambient__aurora--two"></div>
  <div class="ambient__kanji ambient__kanji--one">研究</div>
  <div class="ambient__kanji ambient__kanji--two">未来</div>
  <div class="ambient__scanline"></div>
</div>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-starfield]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas) {
    const context = canvas.getContext('2d');
    let frame = 0;
    let width = 0;
    let height = 0;
    let stars: Array<{ x: number; y: number; radius: number; alpha: number; speed: number }> = [];

    const resize = () => {
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width * ratio;
      canvas.height = height * ratio;
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      context?.setTransform(ratio, 0, 0, ratio, 0, 0);
      const count = Math.min(64, Math.max(28, Math.floor(width / 24)));
      stars = Array.from({ length: count }, (_, index) => ({
        x: (index * 97.13) % width,
        y: (index * 53.71) % height,
        radius: 0.45 + (index % 4) * 0.22,
        alpha: 0.16 + (index % 7) * 0.055,
        speed: 0.035 + (index % 5) * 0.012,
      }));
    };

    const draw = () => {
      if (!context) return;
      context.clearRect(0, 0, width, height);
      stars.forEach((star, index) => {
        const pulse = reducedMotion ? 1 : 0.72 + Math.sin(frame * 0.012 + index) * 0.28;
        context.beginPath();
        context.fillStyle = `rgba(${index % 3 === 0 ? '167, 122, 255' : '113, 226, 255'}, ${star.alpha * pulse})`;
        context.arc(star.x, star.y, star.radius, 0, Math.PI * 2);
        context.fill();
        if (!reducedMotion) {
          star.y -= star.speed;
          if (star.y < -2) star.y = height + 2;
        }
      });
      frame += 1;
      if (!reducedMotion) requestAnimationFrame(draw);
    };

    resize();
    draw();
    window.addEventListener('resize', resize, { passive: true });
  }
</script>

<style>
  .ambient {
    position: fixed;
    z-index: -2;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .ambient::before {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 0%, transparent 0, rgba(4, 6, 18, 0.32) 56%, rgba(4, 6, 18, 0.9) 100%),
      linear-gradient(180deg, rgba(8, 10, 28, 0.1), rgba(5, 7, 20, 0.68));
    content: '';
  }

  .ambient__stars,
  .ambient__grid,
  .ambient__scanline {
    position: absolute;
    inset: 0;
  }

  .ambient__grid {
    opacity: 0.16;
    background-image:
      linear-gradient(rgba(100, 207, 255, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(100, 207, 255, 0.1) 1px, transparent 1px);
    background-position: center top;
    background-size: 72px 72px;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.75), transparent 74%);
    transform: perspective(600px) rotateX(58deg) scale(1.65) translateY(-18%);
    transform-origin: top;
  }

  .ambient__aurora {
    position: absolute;
    width: min(52rem, 80vw);
    height: min(52rem, 80vw);
    border-radius: 50%;
    opacity: 0.17;
    filter: blur(90px);
  }

  .ambient__aurora--one {
    top: -23rem;
    right: -13rem;
    background: #664eff;
    animation: aurora-drift 15s ease-in-out infinite alternate;
  }

  .ambient__aurora--two {
    bottom: -28rem;
    left: -20rem;
    background: #0fc8e8;
    animation: aurora-drift 18s ease-in-out 1s infinite alternate-reverse;
  }

  .ambient__kanji {
    position: absolute;
    color: rgba(169, 147, 255, 0.025);
    font-size: clamp(8rem, 21vw, 23rem);
    font-weight: 800;
    line-height: 1;
    writing-mode: vertical-rl;
  }

  .ambient__kanji--one {
    top: 20%;
    right: -2vw;
  }

  .ambient__kanji--two {
    bottom: 4%;
    left: -2vw;
  }

  .ambient__scanline {
    opacity: 0.025;
    background: repeating-linear-gradient(to bottom, transparent 0, transparent 3px, #fff 4px);
  }

  @keyframes aurora-drift {
    to { transform: translate3d(-4rem, 3rem, 0) scale(1.08); }
  }
</style>
