---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import companion from '../assets/ai-companion.png';
import { profile } from '../data/profile';
import Icon from './Icon.astro';

const cvUrl = `${import.meta.env.BASE_URL}${profile.links.cv}`;
---

<section class="hero section-shell" id="home" aria-labelledby="hero-title">
  <div class="hero__index" aria-hidden="true">
    <span>PORTFOLIO / 2026</span>
    <span>KAIST · REPUBLIC OF KOREA</span>
  </div>

  <div class="hero__grid">
    <div class="hero__copy">
      <div class="signal-chip hero-enter" style="--delay: 60ms">
        <span class="signal-chip__dot"></span>
        KAIST · RESEARCH CHANNEL OPEN
      </div>

      <p class="hero__hello hero-enter" style="--delay: 120ms">Hello, I’m</p>
      <h1 class="hero-enter" id="hero-title" style="--delay: 170ms">
        <span>Tianhao</span>
        <span class="hero__surname">Chen.</span>
      </h1>

      <div class="hero__identity hero-enter" style="--delay: 230ms">
        <span class="hero__identity-rule"></span>
        <div>
          <strong>{profile.title}</strong>
          <span>{profile.affiliation}</span>
        </div>
      </div>

      <p class="hero__statement hero-enter" style="--delay: 290ms">{profile.statement}</p>

      <div class="hero__topic hero-enter" style="--delay: 340ms" aria-live="polite" data-topics={JSON.stringify(profile.rotatingTopics)}>
        <span class="hero__topic-label">FOCUS://</span>
        <span data-rotating-topic>{profile.rotatingTopics[0]}</span>
        <i aria-hidden="true"></i>
      </div>

      <div class="hero__actions hero-enter" style="--delay: 400ms">
        <a class="button button--primary" href={cvUrl} target="_blank" rel="noreferrer">
          <Icon name="file" />
          CV / Resume
          <Icon name="arrow-up-right" size={15} />
        </a>
        <a class="button button--icon" href={profile.links.scholar} target="_blank" rel="noreferrer" aria-label="Google Scholar">
          <Icon name="scholar" />
          <span>Scholar</span>
        </a>
        <a class="button button--icon" href={profile.links.github} target="_blank" rel="noreferrer" aria-label="GitHub">
          <Icon name="github" />
          <span>GitHub</span>
        </a>
        <a class="button button--icon" href={profile.links.email} aria-label={`Email ${profile.email}`}>
          <Icon name="mail" />
          <span>Email</span>
        </a>
      </div>

      <div class="hero__meta hero-enter" style="--delay: 470ms" aria-label="Research profile summary">
        <div><strong>03</strong><span>research works</span></div>
        <div><strong>02</strong><span>core research axes</span></div>
        <div><strong>03</strong><span>academic countries</span></div>
      </div>
    </div>

    <div class="hero__visual hero-enter" style="--delay: 210ms" data-tilt-zone>
      <div class="visual-orbit visual-orbit--outer" aria-hidden="true"></div>
      <div class="visual-orbit visual-orbit--inner" aria-hidden="true"></div>
      <div class="portrait-card" data-tilt-card>
        <div class="portrait-card__bar">
          <span>PROFILE_CAPTURE</span>
          <span class="portrait-card__status">LIVE</span>
        </div>
        <div class="portrait-card__frame">
          <Image
            src={avatar}
            alt="Tianhao Chen's cat, used as his profile avatar"
            widths={[420, 640, 880]}
            sizes="(max-width: 760px) 78vw, 420px"
            format="webp"
            quality={82}
            loading="eager"
            fetchpriority="high"
          />
          <div class="portrait-card__overlay" aria-hidden="true"></div>
          <span class="hud-corner hud-corner--tl"></span>
          <span class="hud-corner hud-corner--tr"></span>
          <span class="hud-corner hud-corner--bl"></span>
          <span class="hud-corner hud-corner--br"></span>
        </div>
        <div class="portrait-card__footer">
          <span>SUBJECT // TIANHAO</span>
          <span>NODE 01</span>
        </div>
      </div>

      <Image
        class="ai-companion"
        src={companion}
        alt=""
        aria-hidden="true"
        widths={[260, 400, 560]}
        sizes="(max-width: 760px) 35vw, 240px"
        format="webp"
        quality={78}
      />

      <div class="status-window">
        <div class="status-window__top">
          <span>NAVI // STATUS</span><span aria-hidden="true">•••</span>
        </div>
        <p><span>&gt;</span> {profile.status}</p>
        <div class="status-window__meter"><i></i></div>
      </div>

      <div class="visual-label visual-label--a" aria-hidden="true">研究 // RESEARCH</div>
      <div class="visual-label visual-label--b" aria-hidden="true">MULTIMODAL_NODE_01</div>
    </div>
  </div>

  <a class="hero__explore" href="#about">
    <span>EXPLORE THE ARCHIVE</span>
    <Icon name="arrow-down" size={17} />
  </a>
</section>

<script>
  const rotating = document.querySelector('[data-rotating-topic]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (rotating && !reduce) {
    const container = rotating.closest<HTMLElement>('[data-topics]');
    const topics = JSON.parse(container?.dataset.topics ?? '[]') as string[];
    let topicIndex = 0;
    if (topics.length > 1) window.setInterval(() => {
      rotating.classList.add('is-changing');
      window.setTimeout(() => {
        topicIndex = (topicIndex + 1) % topics.length;
        rotating.textContent = topics[topicIndex];
        rotating.classList.remove('is-changing');
      }, 220);
    }, 3000);
  }

  const tiltZone = document.querySelector<HTMLElement>('[data-tilt-zone]');
  const tiltCard = document.querySelector<HTMLElement>('[data-tilt-card]');
  if (tiltZone && tiltCard && !reduce && window.matchMedia('(pointer: fine)').matches) {
    tiltZone.addEventListener('pointermove', (event) => {
      const rect = tiltZone.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width - 0.5;
      const y = (event.clientY - rect.top) / rect.height - 0.5;
      tiltCard.style.transform = `perspective(900px) rotateY(${x * 4}deg) rotateX(${y * -4}deg) translate3d(0, -2px, 0)`;
    });
    tiltZone.addEventListener('pointerleave', () => {
      tiltCard.style.transform = '';
    });
  }
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    padding-top: clamp(8.5rem, 13vh, 11rem);
    padding-bottom: 5rem;
    align-content: center;
  }

  .hero::before {
    position: absolute;
    z-index: -1;
    top: 12%;
    right: 3%;
    width: min(45rem, 52vw);
    aspect-ratio: 1;
    border: 1px solid rgba(121, 194, 255, 0.08);
    border-radius: 50%;
    background:
      radial-gradient(circle, rgba(110, 86, 255, 0.14), transparent 59%),
      repeating-radial-gradient(circle, transparent 0, transparent 44px, rgba(127, 210, 255, 0.04) 45px, transparent 46px);
    content: '';
  }

  .hero__index {
    position: absolute;
    top: 8.1rem;
    right: 0;
    left: 0;
    display: flex;
    justify-content: space-between;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.14em;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(25rem, 0.95fr);
    gap: clamp(2rem, 5vw, 6.5rem);
    align-items: center;
  }

  .hero__copy {
    position: relative;
    z-index: 2;
    padding-top: 1.2rem;
  }

  .signal-chip {
    display: inline-flex;
    gap: 0.62rem;
    padding: 0.53rem 0.78rem;
    align-items: center;
    border: 1px solid rgba(90, 218, 255, 0.22);
    border-radius: 99px;
    background: rgba(65, 183, 233, 0.06);
    color: #a7eafa;
    font-family: var(--font-mono);
    font-size: 0.59rem;
    letter-spacing: 0.12em;
  }

  .signal-chip__dot {
    position: relative;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 13px var(--cyan);
  }

  .signal-chip__dot::after {
    position: absolute;
    inset: -4px;
    border: 1px solid rgba(83, 215, 255, 0.5);
    border-radius: inherit;
    animation: signal 1.8s ease-out infinite;
    content: '';
  }

  .hero__hello {
    margin: clamp(2rem, 5vh, 3.6rem) 0 0.2rem;
    color: var(--text-soft);
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.6vw, 1.32rem);
    font-weight: 500;
  }

  .hero h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4.4rem, 9.1vw, 8.8rem);
    font-weight: 650;
    letter-spacing: -0.075em;
    line-height: 0.79;
  }

  .hero h1 span {
    display: block;
  }

  .hero__surname {
    padding-bottom: 0.12em;
    background: linear-gradient(100deg, #fff 4%, #ac9bff 48%, #64ddff 86%);
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 28px rgba(116, 94, 255, 0.18));
  }

  .hero__identity {
    display: flex;
    gap: 0.85rem;
    margin-top: clamp(1.8rem, 4vw, 2.7rem);
    align-items: stretch;
  }

  .hero__identity-rule {
    width: 2px;
    background: linear-gradient(var(--violet), var(--cyan));
    box-shadow: 0 0 14px rgba(83, 215, 255, 0.45);
  }

  .hero__identity div {
    display: grid;
    gap: 0.18rem;
  }

  .hero__identity strong {
    font-family: var(--font-display);
    font-size: 1.02rem;
  }

  .hero__identity div span {
    color: var(--text-soft);
    font-size: 0.83rem;
  }

  .hero__statement {
    max-width: 40rem;
    margin: 1.6rem 0 0;
    color: var(--text-soft);
    font-size: clamp(1rem, 1.4vw, 1.13rem);
    line-height: 1.8;
  }

  .hero__topic {
    display: flex;
    min-height: 1.5rem;
    gap: 0.35rem;
    margin-top: 1rem;
    align-items: center;
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  .hero__topic-label {
    color: var(--text-dim);
  }

  [data-rotating-topic] {
    transition: opacity 200ms ease, transform 200ms ease;
  }

  [data-rotating-topic].is-changing {
    opacity: 0;
    transform: translateY(0.35rem);
  }

  .hero__topic i {
    width: 0.5rem;
    height: 1rem;
    margin-left: 0.05rem;
    background: var(--cyan);
    animation: blink 1s step-end infinite;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 2rem;
  }

  .button {
    position: relative;
    display: inline-flex;
    min-height: 3.15rem;
    gap: 0.6rem;
    padding: 0 1.05rem;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 0.8rem;
    background: rgba(255, 255, 255, 0.025);
    color: var(--text);
    font-family: var(--font-display);
    font-size: 0.76rem;
    font-weight: 650;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }

  .button::before {
    position: absolute;
    top: 0;
    left: -110%;
    width: 70%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.17), transparent);
    transform: skewX(-20deg);
    transition: left 500ms ease;
    content: '';
  }

  .button:hover::before { left: 140%; }
  .button:hover { transform: translateY(-2px); }

  .button--primary {
    padding-inline: 1.25rem;
    border-color: rgba(136, 116, 255, 0.55);
    background: linear-gradient(120deg, rgba(115, 85, 255, 0.3), rgba(49, 188, 229, 0.2));
    box-shadow: inset 0 0 22px rgba(122, 94, 255, 0.1), 0 9px 28px rgba(64, 42, 180, 0.17);
  }

  .button--primary:hover {
    border-color: rgba(115, 222, 255, 0.72);
    box-shadow: 0 12px 35px rgba(72, 65, 212, 0.3);
  }

  .hero__meta {
    display: flex;
    gap: clamp(1.2rem, 3vw, 2.8rem);
    margin-top: 2.4rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hero__meta div {
    display: grid;
    gap: 0.05rem;
  }

  .hero__meta strong {
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1rem;
  }

  .hero__meta span {
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero__visual {
    position: relative;
    width: min(100%, 35rem);
    min-height: 41rem;
    margin-inline: auto;
  }

  .portrait-card {
    position: absolute;
    z-index: 2;
    top: 4.6rem;
    right: 3.7rem;
    width: min(22rem, 70%);
    padding: 0.58rem;
    border: 1px solid rgba(111, 222, 255, 0.33);
    border-radius: 1.15rem 1.15rem 3.6rem 1.15rem;
    background: linear-gradient(145deg, rgba(23, 28, 60, 0.85), rgba(8, 12, 31, 0.9));
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.43), 0 0 42px rgba(80, 62, 210, 0.15);
    transition: transform 180ms ease;
    transform-style: preserve-3d;
    backdrop-filter: blur(14px);
  }

  .portrait-card::before {
    position: absolute;
    z-index: -1;
    inset: -7px;
    border: 1px solid rgba(139, 109, 255, 0.15);
    border-radius: 1.45rem 1.45rem 3.95rem 1.45rem;
    content: '';
  }

  .portrait-card__bar,
  .portrait-card__footer {
    display: flex;
    padding: 0.35rem 0.4rem 0.55rem;
    align-items: center;
    justify-content: space-between;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.11em;
  }

  .portrait-card__status {
    color: var(--cyan);
  }

  .portrait-card__status::before {
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-right: 0.38rem;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 8px var(--cyan);
    content: '';
  }

  .portrait-card__frame {
    position: relative;
    aspect-ratio: 0.82;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.75rem 0.75rem 3rem 0.75rem;
    background: #11152b;
    clip-path: polygon(0 0, 92% 0, 100% 8%, 100% 100%, 12% 100%, 0 90%);
  }

  .portrait-card__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 52% 44%;
    filter: saturate(0.88) contrast(1.04) brightness(0.85);
    transform: scale(1.015);
  }

  .portrait-card__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(87, 219, 255, 0.04), transparent 42%, rgba(81, 58, 190, 0.17)),
      repeating-linear-gradient(to bottom, transparent 0, transparent 5px, rgba(177, 225, 255, 0.025) 6px);
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .portrait-card__footer {
    padding: 0.55rem 0.4rem 0.28rem;
  }

  .hud-corner {
    position: absolute;
    width: 1.1rem;
    height: 1.1rem;
    border-color: var(--cyan);
    opacity: 0.78;
  }

  .hud-corner--tl { top: 0.75rem; left: 0.75rem; border-top: 1px solid; border-left: 1px solid; }
  .hud-corner--tr { top: 0.75rem; right: 0.75rem; border-top: 1px solid; border-right: 1px solid; }
  .hud-corner--bl { bottom: 0.75rem; left: 0.75rem; border-bottom: 1px solid; border-left: 1px solid; }
  .hud-corner--br { right: 0.75rem; bottom: 0.75rem; border-right: 1px solid; border-bottom: 1px solid; }

  .visual-orbit {
    position: absolute;
    border: 1px solid rgba(102, 216, 255, 0.15);
    border-radius: 50%;
  }

  .visual-orbit::before,
  .visual-orbit::after {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 12px var(--cyan);
    content: '';
  }

  .visual-orbit--outer {
    inset: 1rem 0.5rem 2rem;
    border-style: dashed;
    animation: orbit-spin 36s linear infinite;
  }

  .visual-orbit--outer::before { top: 18%; left: 3%; }
  .visual-orbit--outer::after { right: 7%; bottom: 12%; background: var(--pink); box-shadow: 0 0 12px var(--pink); }

  .visual-orbit--inner {
    inset: 5rem 4.2rem 6rem;
    border-color: rgba(141, 109, 255, 0.21);
    animation: orbit-spin 24s linear infinite reverse;
  }

  .visual-orbit--inner::before { top: -4px; left: 50%; background: var(--violet-soft); box-shadow: 0 0 12px var(--violet); }
  .visual-orbit--inner::after { display: none; }

  .ai-companion {
    position: absolute;
    z-index: 5;
    right: -1.5rem;
    bottom: 2.4rem;
    width: min(16rem, 44%);
    height: auto;
    filter: drop-shadow(0 12px 20px rgba(18, 11, 67, 0.55)) drop-shadow(0 0 16px rgba(76, 203, 255, 0.2));
    animation: companion-float 5s ease-in-out infinite;
  }

  .status-window {
    position: absolute;
    z-index: 6;
    bottom: 4.1rem;
    left: -0.5rem;
    width: 15rem;
    padding: 0.78rem 0.85rem 0.8rem;
    border: 1px solid rgba(125, 112, 255, 0.34);
    border-radius: 0.8rem 0.8rem 0.8rem 0;
    background: rgba(8, 11, 30, 0.86);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(13px);
  }

  .status-window::before {
    position: absolute;
    bottom: -0.55rem;
    left: -1px;
    border-top: 0.6rem solid rgba(8, 11, 30, 0.9);
    border-right: 0.7rem solid transparent;
    content: '';
  }

  .status-window__top {
    display: flex;
    padding-bottom: 0.5rem;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
  }

  .status-window p {
    margin: 0.65rem 0 0.7rem;
    color: var(--text-soft);
    font-size: 0.68rem;
    line-height: 1.55;
  }

  .status-window p span { color: var(--cyan); }

  .status-window__meter {
    height: 2px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.08);
  }

  .status-window__meter i {
    display: block;
    width: 72%;
    height: 100%;
    background: linear-gradient(90deg, var(--violet), var(--cyan));
    box-shadow: 0 0 8px var(--cyan);
  }

  .visual-label {
    position: absolute;
    color: rgba(180, 209, 255, 0.4);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.12em;
    writing-mode: vertical-rl;
  }

  .visual-label--a { top: 6rem; left: 1.2rem; }
  .visual-label--b { top: 3.5rem; right: 1rem; }

  .hero__explore {
    position: absolute;
    bottom: 1.5rem;
    left: 0;
    display: inline-flex;
    gap: 0.75rem;
    align-items: center;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.13em;
    text-decoration: none;
  }

  .hero__explore :global(svg) { color: var(--cyan); animation: explore 1.8s ease-in-out infinite; }

  @keyframes signal { to { opacity: 0; transform: scale(1.8); } }
  @keyframes blink { 50% { opacity: 0; } }
  @keyframes orbit-spin { to { transform: rotate(360deg); } }
  @keyframes companion-float { 50% { transform: translateY(-0.6rem) rotate(1deg); } }
  @keyframes explore { 50% { transform: translateY(0.3rem); } }

  @media (max-width: 1100px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.72fr);
      gap: 1rem;
    }

    .hero__visual { min-height: 36rem; }
    .portrait-card { right: 1.8rem; }
    .status-window { left: -1rem; }
    .ai-companion { right: -0.8rem; }
    .button--icon span { display: none; }
    .button--icon { width: 3.15rem; padding: 0; }
  }

  @media (max-width: 820px) {
    .hero {
      min-height: auto;
      padding-top: 9.5rem;
      padding-bottom: 7rem;
    }

    .hero__index { top: 7.4rem; }
    .hero__index span:last-child { display: none; }

    .hero__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero__copy { padding-top: 0; }
    .hero h1 { font-size: clamp(4.4rem, 18vw, 7rem); }
    .hero__visual { width: min(100%, 33rem); min-height: 38rem; }
    .portrait-card { right: 12%; width: 68%; }
    .status-window { left: 2%; }
    .ai-companion { right: 2%; }
  }

  @media (max-width: 540px) {
    .hero { padding-top: 8.8rem; }
    .signal-chip { font-size: 0.51rem; }
    .hero__hello { margin-top: 2rem; }
    .hero h1 { font-size: clamp(4rem, 21vw, 6.2rem); }
    .hero__statement { font-size: 0.96rem; }
    .hero__actions { display: grid; grid-template-columns: 1fr repeat(3, 3.15rem); }
    .button--primary { min-width: 0; padding-inline: 0.9rem; }
    .hero__meta { justify-content: space-between; gap: 0.7rem; }
    .hero__meta span { font-size: 0.46rem; }
    .hero__visual { min-height: 31rem; }
    .portrait-card { top: 2.8rem; right: 8%; width: 75%; }
    .status-window { bottom: 1.2rem; left: 0; width: 13rem; }
    .ai-companion { right: -4%; bottom: -0.2rem; width: 48%; }
    .visual-orbit--outer { inset: 1rem 1rem 2rem; }
    .visual-orbit--inner { inset: 4rem 3rem 5rem; }
    .visual-label--a { left: 0; }
    .visual-label--b { right: 0; }
  }
</style>
