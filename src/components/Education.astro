---
import { Image } from 'astro:assets';
import { education } from '../data/education';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
---

<section class="content-section section-shell" id="education" aria-labelledby="education-heading">
  <SectionHeading
    index="03"
    eyebrow="Academic route"
    title="Education"
    japanese="学歴"
    description="An academic path across Korea, Japan, and China."
    headingId="education-heading"
  />

  <div class="education-timeline">
    {education.map((item, index) => (
      <article class="education-entry reveal">
        <div class="education-entry__rail" aria-hidden="true">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <i></i>
        </div>
        <div class="education-card glass-panel">
          <a class:list={['education-card__logo', item.logoClass]} href={item.url} target="_blank" rel="noreferrer" aria-label={`${item.school} website`}>
            <Image src={item.logo} alt={`${item.shortName} logo`} loading="lazy" />
          </a>
          <div class="education-card__content">
            <div class="education-card__meta">
              <span>{item.period}</span>
              <span>{item.location}</span>
            </div>
            <a class="education-card__school" href={item.url} target="_blank" rel="noreferrer">
              <h3>{item.shortName}</h3><Icon name="arrow-up-right" size={17} />
            </a>
            <p class="education-card__full-name">{item.school}</p>
            <p class="education-card__degree">{item.degree}</p>
            {item.department && <p class="education-card__department">{item.department}</p>}
            {item.details.length > 0 && (
              <ul>
                {item.details.map((detail) => <li>{detail}</li>)}
              </ul>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .education-timeline {
    position: relative;
    display: grid;
    gap: 1rem;
  }

  .education-entry {
    display: grid;
    grid-template-columns: 5.6rem 1fr;
    gap: 1.25rem;
  }

  .education-entry__rail {
    position: relative;
    display: flex;
    justify-content: flex-end;
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 0.6rem;
  }

  .education-entry__rail span {
    display: grid;
    width: 2rem;
    height: 2rem;
    margin-top: 2rem;
    place-items: center;
    border: 1px solid rgba(83, 215, 255, 0.32);
    border-radius: 50%;
    background: var(--bg);
    box-shadow: 0 0 18px rgba(83, 215, 255, 0.08);
  }

  .education-entry__rail i {
    position: absolute;
    top: 4rem;
    right: 0.98rem;
    bottom: -3rem;
    width: 1px;
    background: linear-gradient(var(--cyan), rgba(124, 92, 255, 0.12));
    opacity: 0.35;
  }

  .education-entry:last-child .education-entry__rail i {
    display: none;
  }

  .education-card {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: clamp(1.2rem, 3vw, 2.5rem);
    padding: clamp(1.2rem, 3vw, 2rem);
    align-items: center;
    transition: border-color 220ms ease, transform 220ms ease;
  }

  .education-card:hover {
    border-color: rgba(99, 206, 255, 0.24);
    transform: translateX(0.25rem);
  }

  .education-card__logo {
    display: grid;
    width: 100%;
    min-height: 8rem;
    padding: 1.25rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.8rem;
    background: #fff;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
  }

  .education-card__logo :global(img) {
    display: block;
    width: 100%;
    max-height: 5.5rem;
    object-fit: contain;
  }

  .education-card__logo.logo-mark :global(img) {
    width: 5.8rem;
    height: 5.8rem;
  }

  .education-card__meta {
    display: flex;
    margin-bottom: 0.85rem;
    justify-content: space-between;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .education-card__meta span:first-child {
    color: var(--cyan);
  }

  .education-card__school {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    color: var(--text);
    text-decoration: none;
  }

  .education-card__school h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.3vw, 2rem);
    letter-spacing: -0.035em;
  }

  .education-card__school :global(svg) {
    color: var(--text-dim);
    transition: color 180ms ease, transform 180ms ease;
  }

  .education-card__school:hover :global(svg) {
    color: var(--cyan);
    transform: translate(2px, -2px);
  }

  .education-card__full-name {
    margin: 0.25rem 0 1.2rem;
    color: var(--text-dim);
    font-size: 0.72rem;
  }

  .education-card__degree {
    margin: 0;
    color: #dce4ff;
    font-weight: 600;
  }

  .education-card__department {
    margin: 0.2rem 0 0;
    color: var(--text-soft);
    font-size: 0.83rem;
  }

  .education-card ul {
    display: grid;
    gap: 0.45rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .education-card li {
    position: relative;
    padding-left: 1rem;
    color: var(--text-soft);
    font-size: 0.76rem;
    line-height: 1.65;
  }

  .education-card li::before {
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 0.35rem;
    height: 1px;
    background: var(--violet-soft);
    content: '';
  }

  @media (max-width: 720px) {
    .education-entry { grid-template-columns: 2.2rem 1fr; gap: 0.7rem; }
    .education-entry__rail { justify-content: flex-start; }
    .education-entry__rail span { width: 1.75rem; height: 1.75rem; font-size: 0.52rem; }
    .education-entry__rail i { right: auto; left: 0.86rem; top: 3.75rem; }
    .education-card { grid-template-columns: 1fr; }
    .education-card__logo { min-height: 6.5rem; }
    .education-card__logo :global(img) { max-width: 13rem; max-height: 4.5rem; }
  }

  @media (max-width: 430px) {
    .education-card__meta { display: grid; gap: 0.25rem; }
    .education-card__full-name { font-size: 0.66rem; }
  }
</style>
