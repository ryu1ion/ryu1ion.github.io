---
import { highlights } from '../data/highlights';
import SectionHeading from './SectionHeading.astro';
---

<section class="content-section section-shell" id="research" aria-labelledby="research-heading">
  <SectionHeading
    index="02"
    eyebrow="Selected vectors"
    title="Research highlights"
    japanese="研究方向"
    description="Three connected questions: what agents share, what models remember, and how intelligence unfolds over time."
    headingId="research-heading"
  />

  <div class="highlight-grid">
    {highlights.map((item, index) => (
      <article class="highlight-card reveal" style={`--card-index:${index}`}>
        <div class="highlight-card__top">
          <span>{item.code}</span>
          <span>0{index + 1} / 03</span>
        </div>
        <div class="highlight-card__visual" aria-hidden="true">
          <div class="signal-map">
            <i></i><i></i><i></i><i></i><i></i>
            <span></span><span></span><span></span>
          </div>
          <strong>{String(index + 1).padStart(2, '0')}</strong>
        </div>
        <p class="highlight-card__eyebrow">{item.eyebrow}</p>
        <h3>{item.title}</h3>
        <p class="highlight-card__description">{item.description}</p>
        <div class="tag-row">
          {item.tags.map((tag) => <span>{tag}</span>)}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .highlight-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .highlight-card {
    position: relative;
    min-height: 31rem;
    padding: 1.15rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background:
      linear-gradient(155deg, rgba(131, 91, 255, calc(0.035 + var(--card-index) * 0.01)), transparent 45%),
      rgba(12, 16, 39, 0.72);
    transition: transform 260ms ease, border-color 260ms ease, box-shadow 260ms ease;
  }

  .highlight-card::after {
    position: absolute;
    right: -1px;
    bottom: -1px;
    width: 2.2rem;
    height: 2.2rem;
    border-top: 1px solid var(--line-strong);
    background: var(--bg);
    content: '';
    clip-path: polygon(100% 0, 100% 100%, 0 100%);
  }

  .highlight-card:hover {
    border-color: rgba(107, 207, 255, 0.27);
    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.23), inset 0 0 30px rgba(112, 86, 255, 0.04);
    transform: translateY(-0.35rem);
  }

  .highlight-card__top {
    display: flex;
    justify-content: space-between;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
  }

  .highlight-card__top span:first-child { color: var(--cyan); }

  .highlight-card__visual {
    position: relative;
    display: grid;
    height: 12rem;
    margin: 1rem 0 1.6rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 0.75rem;
    background:
      linear-gradient(rgba(97, 202, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(97, 202, 255, 0.04) 1px, transparent 1px),
      radial-gradient(circle at 50% 50%, rgba(107, 78, 237, 0.15), transparent 70%);
    background-size: 22px 22px, 22px 22px, auto;
  }

  .highlight-card__visual > strong {
    position: absolute;
    right: 0.7rem;
    bottom: 0.35rem;
    color: rgba(255, 255, 255, 0.04);
    font-family: var(--font-display);
    font-size: 4.2rem;
  }

  .signal-map {
    position: relative;
    width: 8rem;
    height: 6.2rem;
  }

  .signal-map i {
    position: absolute;
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid var(--cyan);
    border-radius: 50%;
    background: var(--bg);
    box-shadow: 0 0 12px rgba(83, 215, 255, 0.5);
  }

  .signal-map i:nth-child(1) { top: 4%; left: 46%; }
  .signal-map i:nth-child(2) { top: 42%; left: 4%; }
  .signal-map i:nth-child(3) { top: 64%; left: 49%; }
  .signal-map i:nth-child(4) { top: 26%; right: 3%; }
  .signal-map i:nth-child(5) { right: 17%; bottom: 0; border-color: var(--pink); box-shadow: 0 0 12px rgba(255, 110, 199, 0.55); }

  .signal-map span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 6.6rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(83, 215, 255, 0.66), transparent);
    transform-origin: center;
  }

  .signal-map span:nth-of-type(1) { transform: translate(-50%, -50%) rotate(15deg); }
  .signal-map span:nth-of-type(2) { transform: translate(-50%, -50%) rotate(123deg); }
  .signal-map span:nth-of-type(3) { transform: translate(-50%, -50%) rotate(-38deg); }

  .highlight-card:nth-child(2) .signal-map { transform: rotate(90deg) scale(0.88); }
  .highlight-card:nth-child(2) .signal-map i { border-radius: 1px; }
  .highlight-card:nth-child(3) .signal-map span:nth-of-type(1) { transform: translate(-50%, -50%) rotate(0) scaleX(1.2); }
  .highlight-card:nth-child(3) .signal-map span:nth-of-type(2) { transform: translate(-50%, -50%) rotate(35deg); }

  .highlight-card__eyebrow {
    margin: 0 0 0.65rem;
    color: var(--violet-soft);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .highlight-card h3 {
    max-width: 14ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    letter-spacing: -0.035em;
    line-height: 1.18;
  }

  .highlight-card__description {
    margin: 1rem 0 1.35rem;
    color: var(--text-soft);
    font-size: 0.82rem;
    line-height: 1.75;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag-row span {
    padding: 0.32rem 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.35rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.5rem;
  }

  @media (max-width: 940px) {
    .highlight-grid { grid-template-columns: 1fr; }
    .highlight-card {
      display: grid;
      grid-template-columns: minmax(12rem, 0.65fr) 1fr;
      gap: 0 1.5rem;
      min-height: auto;
    }
    .highlight-card__top { grid-column: 1 / -1; }
    .highlight-card__visual { grid-row: 2 / 6; height: 100%; min-height: 14rem; }
    .highlight-card__eyebrow { margin-top: 1.2rem; align-self: end; }
  }

  @media (max-width: 640px) {
    .highlight-card { display: block; }
    .highlight-card__visual { height: 11rem; min-height: 0; }
  }
</style>
