---
import Icon from './Icon.astro';
import { navigation } from '../data/profile';
---

<header class="site-nav" data-nav>
  <div class="site-nav__inner">
    <a class="brand" href="#home" aria-label="TC — Tianhao Chen — back to top">
      <span class="brand__mark" aria-hidden="true">TC</span>
      <span class="brand__copy">
        <strong>Tianhao Chen</strong>
        <small>research.log</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {navigation.map((item, index) => (
        <a href={item.href} data-nav-link>
          <span>{String(index + 1).padStart(2, '0')}</span>{item.label}
        </a>
      ))}
    </nav>

    <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
      <span class="menu-open"><Icon name="menu" size={21} /></span>
      <span class="menu-close"><Icon name="x" size={21} /></span>
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation" data-mobile-nav>
    {navigation.map((item, index) => (
      <a href={item.href} data-nav-link>
        <span>{String(index + 1).padStart(2, '0')}</span>{item.label}
      </a>
    ))}
    <div class="mobile-nav__meta">
      <span>SYSTEM ONLINE</span>
      <span>KAIST / 2026</span>
    </div>
  </nav>
</header>

<style>
  .site-nav {
    position: fixed;
    z-index: 100;
    top: 0;
    right: 0;
    left: 0;
    padding: 1rem var(--page-pad);
    transition: padding 250ms ease, background 250ms ease;
  }

  .site-nav.is-scrolled {
    padding-top: 0.65rem;
  }

  .site-nav__inner {
    display: flex;
    width: min(100%, var(--content-width));
    height: 4.25rem;
    margin: 0 auto;
    padding: 0.55rem 0.7rem 0.55rem 0.6rem;
    align-items: center;
    justify-content: space-between;
    border: 1px solid color-mix(in srgb, var(--line), transparent 6%);
    border-radius: 1.05rem;
    background: rgba(7, 10, 27, 0.68);
    box-shadow: 0 12px 44px rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(18px) saturate(125%);
  }

  .is-scrolled .site-nav__inner {
    background: rgba(7, 10, 27, 0.88);
    box-shadow: 0 14px 50px rgba(0, 0, 0, 0.35);
  }

  .brand {
    display: inline-flex;
    gap: 0.72rem;
    align-items: center;
    color: var(--text);
    text-decoration: none;
  }

  .brand__mark {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid rgba(112, 227, 255, 0.5);
    clip-path: polygon(18% 0, 100% 0, 100% 72%, 78% 100%, 0 100%, 0 20%);
    background:
      linear-gradient(135deg, rgba(83, 215, 255, 0.19), rgba(124, 92, 255, 0.2)),
      rgba(255, 255, 255, 0.025);
    color: var(--cyan);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    box-shadow: inset 0 0 20px rgba(83, 215, 255, 0.08);
  }

  .brand__copy {
    display: grid;
    gap: 0.08rem;
  }

  .brand__copy strong {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }

  .brand__copy small {
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .desktop-nav {
    display: flex;
    gap: 0.18rem;
    align-items: center;
  }

  .desktop-nav a {
    position: relative;
    display: inline-flex;
    gap: 0.32rem;
    padding: 0.72rem 0.68rem;
    align-items: baseline;
    border-radius: 0.65rem;
    color: var(--text-soft);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 180ms ease, background 180ms ease;
  }

  .desktop-nav a span {
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.48rem;
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current='true'] {
    background: rgba(120, 105, 255, 0.1);
    color: var(--text);
  }

  .desktop-nav a[aria-current='true']::after {
    position: absolute;
    right: 0.65rem;
    bottom: 0.35rem;
    left: 0.65rem;
    height: 1px;
    background: linear-gradient(90deg, var(--violet), var(--cyan));
    box-shadow: 0 0 10px var(--cyan);
    content: '';
  }

  .menu-toggle {
    display: none;
    width: 2.8rem;
    height: 2.8rem;
    padding: 0;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 0.7rem;
    background: rgba(255, 255, 255, 0.035);
    color: var(--text);
    cursor: pointer;
  }

  .menu-close,
  .menu-toggle[aria-expanded='true'] .menu-open {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .menu-close {
    display: block;
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 940px) {
    .desktop-nav {
      display: none;
    }

    .menu-toggle {
      display: grid;
    }

    .mobile-nav {
      position: absolute;
      top: calc(100% - 0.4rem);
      right: var(--page-pad);
      left: var(--page-pad);
      display: grid;
      width: auto;
      max-height: 0;
      padding: 0 1rem;
      overflow: hidden;
      border: 1px solid transparent;
      border-radius: 1rem;
      visibility: hidden;
      background: rgba(7, 10, 27, 0.96);
      opacity: 0;
      transform: translateY(-0.5rem);
      transition: max-height 300ms ease, padding 300ms ease, opacity 220ms ease, transform 220ms ease, visibility 300ms, border-color 300ms;
      backdrop-filter: blur(20px);
    }

    .mobile-nav.is-open {
      max-height: 35rem;
      padding: 1rem;
      border-color: var(--line);
      visibility: visible;
      opacity: 1;
      transform: translateY(0);
    }

    .mobile-nav a {
      display: flex;
      gap: 1rem;
      padding: 0.95rem 0.5rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      color: var(--text);
      font-family: var(--font-display);
      font-size: 1rem;
      text-decoration: none;
    }

    .mobile-nav a span {
      color: var(--cyan);
      font-family: var(--font-mono);
      font-size: 0.65rem;
    }

    .mobile-nav__meta {
      display: flex;
      padding: 1rem 0.5rem 0.35rem;
      justify-content: space-between;
      color: var(--text-dim);
      font-family: var(--font-mono);
      font-size: 0.55rem;
      letter-spacing: 0.1em;
    }
  }

  @media (max-width: 440px) {
    .brand__copy {
      display: none;
    }
  }
</style>
