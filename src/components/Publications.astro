---
import { publications } from '../data/publications';
import PublicationCard from './PublicationCard.astro';
import SectionHeading from './SectionHeading.astro';
---

<section class="content-section section-shell publications" id="publications" aria-labelledby="publications-heading">
  <SectionHeading
    index="06"
    eyebrow="Research archive"
    title="Publications"
    japanese="論文"
    description="Work on collaborative agents, efficient multimodal inference, and interactive video generation."
    headingId="publications-heading"
  />

  <div class="publications__summary reveal">
    <div>
      <strong>{String(publications.length).padStart(2, '0')}</strong>
      <span>works indexed</span>
    </div>
    <p>Publication status and authorship reflect the latest CV. Direct paper or code links appear only when they are supplied there.</p>
    <span class="publications__scan" aria-hidden="true">ARCHIVE SCAN: COMPLETE</span>
  </div>

  <div class="publication-list">
    {publications.map((publication) => <PublicationCard publication={publication} />)}
  </div>
</section>

<style>
  .publications {
    padding-bottom: clamp(6rem, 13vw, 11rem);
  }

  .publications__summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1.5rem;
    margin-bottom: 1rem;
    padding: 1rem 1.2rem;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.018);
  }

  .publications__summary > div {
    display: flex;
    gap: 0.55rem;
    align-items: baseline;
  }

  .publications__summary strong {
    color: var(--cyan);
    font-family: var(--font-display);
    font-size: 1.45rem;
  }

  .publications__summary span,
  .publications__summary p {
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .publications__summary p {
    margin: 0;
    line-height: 1.6;
    text-transform: none;
  }

  .publications__scan { color: #7ee7c5 !important; }

  .publication-list {
    display: grid;
    gap: 1rem;
  }

  @media (max-width: 740px) {
    .publications__summary { grid-template-columns: auto 1fr; }
    .publications__scan { display: none; }
  }

  @media (max-width: 480px) {
    .publications__summary p { font-size: 0.45rem; }
  }
</style>
