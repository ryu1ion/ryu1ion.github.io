---
import { news } from '../data/news';
import { awards } from '../data/awards';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
---

<section class="content-section section-shell" id="news" aria-labelledby="news-heading">
  <SectionHeading
    index="05"
    eyebrow="Recent signals"
    title="News & recognition"
    japanese="最新情報"
    description="Selected research and academic milestones, kept intentionally concise."
    headingId="news-heading"
  />

  <div class="news-grid">
    <div class="news-feed glass-panel reveal">
      <div class="feed-header">
        <span>LIVE_FEED</span>
        <div><i></i>SYNCED TO CV</div>
      </div>
      <ol>
        {news.map((item, index) => (
          <li>
            <div class="news-date">
              <span>{item.date}</span>
              {item.featured && <small>NEW</small>}
            </div>
            <div class="news-node" aria-hidden="true"><i></i></div>
            <div class="news-copy">
              <span class="news-copy__number">NEWS_{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <aside class="awards-panel reveal" aria-label="Awards and honors">
      <div class="awards-panel__header">
        <span>HONORS.DAT</span>
        <Icon name="spark" size={17} />
      </div>
      <div class="awards-panel__title">
        <small>ACHIEVEMENT ARCHIVE</small>
        <h3>Awards & Honors</h3>
      </div>
      <div class="award-list">
        {awards.map((award, index) => (
          <article>
            <div class="award-list__icon" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
            <div>
              <span>{award.period}</span>
              {award.url ? (
                <a href={award.url} target="_blank" rel="noreferrer">
                  <h4>{award.title}</h4><Icon name="arrow-up-right" size={14} />
                </a>
              ) : <h4>{award.title}</h4>}
              <p>{award.detail}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="awards-panel__seal" aria-hidden="true">
        <span>ACADEMIC</span><strong>✦</strong><span>RECOGNITION</span>
      </div>
    </aside>
  </div>
</section>

<style>
  .news-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(20rem, 0.75fr);
    gap: 1rem;
  }

  .news-feed {
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .feed-header {
    display: flex;
    margin-bottom: 1.3rem;
    padding-bottom: 1rem;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.1em;
  }

  .feed-header > span { color: var(--cyan); }
  .feed-header div { display: flex; gap: 0.5rem; align-items: center; }

  .feed-header i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #68f3bd;
    box-shadow: 0 0 9px #68f3bd;
  }

  .news-feed ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .news-feed li {
    display: grid;
    grid-template-columns: 5.8rem 1.2rem minmax(0, 1fr);
    gap: 1rem;
    min-height: 8.6rem;
  }

  .news-date {
    padding-top: 0.26rem;
    text-align: right;
  }

  .news-date > span {
    display: block;
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .news-date small {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.2rem 0.4rem;
    border: 1px solid rgba(255, 110, 199, 0.34);
    border-radius: 99px;
    background: rgba(255, 110, 199, 0.08);
    color: #ff9bd7;
    font-family: var(--font-mono);
    font-size: 0.44rem;
    letter-spacing: 0.07em;
  }

  .news-node {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .news-node::before {
    position: absolute;
    top: 1.1rem;
    bottom: -0.6rem;
    width: 1px;
    background: linear-gradient(var(--violet), rgba(83, 215, 255, 0.05));
    opacity: 0.5;
    content: '';
  }

  .news-feed li:last-child .news-node::before { display: none; }

  .news-node i {
    position: relative;
    z-index: 1;
    width: 0.52rem;
    height: 0.52rem;
    margin-top: 0.38rem;
    border: 2px solid var(--bg);
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 0 1px rgba(83, 215, 255, 0.4), 0 0 12px rgba(83, 215, 255, 0.55);
  }

  .news-copy {
    padding-bottom: 1.7rem;
  }

  .news-copy__number {
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.48rem;
    letter-spacing: 0.1em;
  }

  .news-copy h3 {
    margin: 0.42rem 0 0.45rem;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.8vw, 1.3rem);
    letter-spacing: -0.025em;
  }

  .news-copy p {
    max-width: 43rem;
    margin: 0;
    color: var(--text-soft);
    font-size: 0.75rem;
    line-height: 1.7;
  }

  .awards-panel {
    position: relative;
    padding: clamp(1.25rem, 3vw, 2rem);
    overflow: hidden;
    border: 1px solid rgba(150, 113, 255, 0.2);
    border-radius: 1rem;
    background:
      linear-gradient(155deg, rgba(116, 79, 220, 0.12), transparent 48%),
      rgba(12, 16, 39, 0.72);
  }

  .awards-panel::before {
    position: absolute;
    right: -5rem;
    bottom: -5rem;
    width: 14rem;
    aspect-ratio: 1;
    border: 1px solid rgba(255, 110, 199, 0.09);
    border-radius: 50%;
    box-shadow: 0 0 0 2rem rgba(124, 92, 255, 0.018), 0 0 0 4rem rgba(124, 92, 255, 0.012);
    content: '';
  }

  .awards-panel__header {
    display: flex;
    padding-bottom: 1rem;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.1em;
  }

  .awards-panel__header :global(svg) { color: var(--pink); }

  .awards-panel__title { margin: 2.2rem 0 2rem; }
  .awards-panel__title small {
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
  }

  .awards-panel__title h3 {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    letter-spacing: -0.04em;
  }

  .award-list { display: grid; gap: 1.5rem; }

  .award-list article {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.9rem;
  }

  .award-list__icon {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid rgba(120, 214, 255, 0.2);
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background: rgba(83, 215, 255, 0.06);
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 0.48rem;
  }

  .award-list article span {
    color: var(--violet-soft);
    font-family: var(--font-mono);
    font-size: 0.5rem;
  }

  .award-list article a {
    display: flex;
    gap: 0.45rem;
    width: fit-content;
    align-items: center;
    color: var(--text);
    text-decoration: none;
  }

  .award-list h4 {
    margin: 0.3rem 0 0.3rem;
    font-family: var(--font-display);
    font-size: 0.9rem;
  }

  .award-list p {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.7rem;
    line-height: 1.6;
  }

  .awards-panel__seal {
    display: flex;
    gap: 0.8rem;
    margin-top: 2.8rem;
    align-items: center;
    justify-content: center;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.43rem;
    letter-spacing: 0.12em;
  }

  .awards-panel__seal strong { color: var(--pink); font-size: 0.8rem; }

  @media (max-width: 920px) {
    .news-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 540px) {
    .news-feed li { grid-template-columns: 4.1rem 0.8rem minmax(0, 1fr); gap: 0.6rem; }
    .news-date > span { font-size: 0.53rem; }
    .news-copy p { font-size: 0.7rem; }
    .feed-header > div { display: none; }
  }
</style>
