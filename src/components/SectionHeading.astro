---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  japanese: string;
  description?: string;
  headingId?: string;
}

const { index, eyebrow, title, japanese, description, headingId } = Astro.props;
---

<header class="section-heading reveal">
  <div class="section-heading__signal" aria-hidden="true">
    <span>{index}</span>
    <i></i>
  </div>
  <div class="section-heading__copy">
    <div class="section-heading__eyebrow">
      <span>{eyebrow}</span>
      <span class="section-heading__jp">{japanese}</span>
    </div>
    <h2 id={headingId}>{title}</h2>
    {description && <p>{description}</p>}
  </div>
</header>

<style>
  .section-heading {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 1.6rem;
    align-items: start;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .section-heading__signal {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding-top: 0.55rem;
    color: var(--cyan);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .section-heading__signal i {
    position: relative;
    display: block;
    width: 3.6rem;
    height: 1px;
    background: linear-gradient(90deg, var(--cyan), transparent);
  }

  .section-heading__signal i::before {
    position: absolute;
    top: -2px;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 12px var(--cyan);
    content: '';
  }

  .section-heading__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 0.55rem;
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: 0.71rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .section-heading__jp {
    color: color-mix(in srgb, var(--pink), transparent 28%);
    font-family: var(--font-body);
    letter-spacing: 0.12em;
  }

  .section-heading h2 {
    max-width: 14ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 4.7rem);
    font-weight: 650;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .section-heading p {
    max-width: 41rem;
    margin: 1rem 0 0;
    color: var(--text-soft);
    line-height: 1.8;
  }

  @media (max-width: 720px) {
    .section-heading {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }

    .section-heading__signal {
      padding-top: 0;
    }
  }
</style>
