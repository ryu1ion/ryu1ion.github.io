---
import type { Publication } from '../data/types';
import Icon from './Icon.astro';

interface Props {
  publication: Publication;
}

const { publication } = Astro.props;
---

<article class:list={['publication-card', `publication-card--${publication.visual.color}`, 'reveal']}>
  <div class="publication-visual">
    <div class="publication-visual__head">
      <span>PAPER_{publication.visual.index}</span>
      <span>{publication.visual.kicker}</span>
    </div>

    <svg viewBox="0 0 420 240" role="img" aria-label={`Abstract visualization for ${publication.title}`}>
      <defs>
        <linearGradient id={`grad-${publication.slug}`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="var(--card-accent)" stop-opacity=".82" />
          <stop offset="1" stop-color="var(--cyan)" stop-opacity=".16" />
        </linearGradient>
        <filter id={`glow-${publication.slug}`} x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="5" result="blur" />
          <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
      </defs>
      <g class="grid-lines" opacity=".18">
        <path d="M20 40H400M20 80H400M20 120H400M20 160H400M20 200H400" />
        <path d="M60 20V220M120 20V220M180 20V220M240 20V220M300 20V220M360 20V220" />
      </g>
      {publication.visual.motif === 'network' && (
        <g class="motif motif--network">
          <path class="trace" d="M69 170 154 77l95 61 99-67M154 77l17 116 78-55 99 35M69 170l102 23 177-122" />
          <circle cx="69" cy="170" r="15" /><circle cx="154" cy="77" r="19" /><circle cx="171" cy="193" r="11" /><circle cx="249" cy="138" r="23" /><circle cx="348" cy="71" r="14" /><circle cx="348" cy="173" r="18" />
          <circle class="pulse" cx="249" cy="138" r="35" />
        </g>
      )}
      {publication.visual.motif === 'boundary' && (
        <g class="motif motif--boundary">
          <path class="blocks" d="M68 63h54v54H68zM132 63h54v54h-54zM196 63h54v54h-54zM260 63h54v54h-54zM68 127h54v54H68zM132 127h54v54h-54zM196 127h54v54h-54zM260 127h54v54h-54z" />
          <path class="trace trace--bold" d="M55 123c35-3 49-26 83-23s45 51 82 38 42-61 83-42 40 48 64 42" />
          <circle cx="138" cy="100" r="7" /><circle cx="220" cy="138" r="7" /><circle cx="303" cy="96" r="7" />
          <path class="bracket" d="M48 45v-9h14M346 36h14v9M48 198v9h14M360 198v9h-14" />
        </g>
      )}
      {publication.visual.motif === 'trajectory' && (
        <g class="motif motif--trajectory">
          <path class="frames" d="M45 65h91v111H45zM164 52h91v136h-91zM283 65h91v111h-91z" />
          <path class="trace trace--bold" d="M65 151c24-47 45-42 71-24s46 22 67-3 49-47 77-11 52 33 79-21" />
          <circle cx="65" cy="151" r="6" /><circle cx="203" cy="124" r="8" /><circle cx="359" cy="92" r="6" />
          <path class="arrow" d="m350 83 11 8-12 6" />
        </g>
      )}
    </svg>

    <div class="publication-visual__footer">
      <span>{publication.keywords[0]}</span>
      <span>TCH / ARCHIVE</span>
    </div>
  </div>

  <div class="publication-copy">
    <div class="publication-copy__meta">
      <span>{publication.venue}</span>
      <span class:list={['paper-badge', `paper-badge--${publication.badgeTone}`]}>
        {publication.badgeTone === 'accepted' && <Icon name="check" size={12} strokeWidth={2.2} />}
        {publication.badge}
      </span>
    </div>
    <h3>{publication.title}</h3>
    <p class="publication-authors">
      {publication.authors.map((author, index) => (
        <><span class:list={{ 'is-self': author.self }}>{author.name}</span>{index < publication.authors.length - 1 ? ', ' : ''}</>
      ))}
    </p>
    <p class="publication-description">{publication.description}</p>
    <div class="publication-bottom">
      <div class="publication-keywords">
        {publication.keywords.map((keyword) => <span>{keyword}</span>)}
      </div>
      {publication.links && publication.links.length > 0 && (
        <div class="publication-links">
          {publication.links.map((link) => (
            <a href={link.href} target="_blank" rel="noreferrer">{link.label}<Icon name="arrow-up-right" size={13} /></a>
          ))}
        </div>
      )}
    </div>
  </div>
</article>

<style>
  .publication-card {
    --card-accent: var(--violet-soft);
    display: grid;
    grid-template-columns: minmax(18rem, 0.78fr) minmax(0, 1.22fr);
    min-height: 24rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: rgba(10, 14, 35, 0.72);
    transition: transform 260ms ease, border-color 260ms ease, box-shadow 260ms ease;
  }

  .publication-card--cyan { --card-accent: var(--cyan); }
  .publication-card--pink { --card-accent: var(--pink); }

  .publication-card:hover {
    border-color: color-mix(in srgb, var(--card-accent), transparent 68%);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.26), inset 0 0 38px color-mix(in srgb, var(--card-accent), transparent 96%);
    transform: translateY(-0.3rem);
  }

  .publication-visual {
    position: relative;
    display: grid;
    min-height: 100%;
    padding: 1rem;
    grid-template-rows: auto 1fr auto;
    overflow: hidden;
    border-right: 1px solid var(--line);
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--card-accent), transparent 88%), transparent 58%),
      #090d23;
  }

  .publication-visual::after {
    position: absolute;
    right: -3rem;
    bottom: -5rem;
    width: 14rem;
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--card-accent), transparent 85%);
    border-radius: 50%;
    box-shadow: 0 0 0 1.5rem color-mix(in srgb, var(--card-accent), transparent 97%), 0 0 0 3rem color-mix(in srgb, var(--card-accent), transparent 98%);
    content: '';
  }

  .publication-visual__head,
  .publication-visual__footer {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.48rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .publication-visual__head span:first-child { color: var(--card-accent); }

  .publication-visual svg {
    width: 100%;
    align-self: center;
    overflow: visible;
  }

  .grid-lines,
  .motif { fill: none; stroke: rgba(162, 201, 255, 0.43); stroke-width: 1; }
  .motif .trace { stroke: url(#grad-laco); stroke-width: 1.4; }
  .publication-card--cyan .motif .trace { stroke: url(#grad-bacon); }
  .publication-card--pink .motif .trace { stroke: url(#grad-delta-forcing); }
  .motif .trace--bold { stroke-width: 2.4; filter: url(#glow-bacon); }
  .publication-card--pink .motif .trace--bold { filter: url(#glow-delta-forcing); }
  .motif circle:not(.pulse) { fill: #090d23; stroke: var(--card-accent); stroke-width: 1.8; filter: url(#glow-laco); }
  .publication-card--cyan .motif circle { filter: url(#glow-bacon); }
  .publication-card--pink .motif circle { filter: url(#glow-delta-forcing); }
  .motif .pulse { stroke: var(--card-accent); opacity: .24; }
  .motif .blocks,
  .motif .frames { stroke: rgba(162, 201, 255, .24); }
  .motif .bracket,
  .motif .arrow { stroke: var(--card-accent); stroke-width: 1.5; }

  .publication-copy {
    display: flex;
    padding: clamp(1.4rem, 4vw, 3rem);
    flex-direction: column;
  }

  .publication-copy__meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.3rem;
    align-items: center;
    justify-content: space-between;
    color: var(--violet-soft);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    line-height: 1.5;
  }

  .paper-badge {
    display: inline-flex;
    flex: 0 0 auto;
    gap: 0.35rem;
    padding: 0.3rem 0.5rem;
    align-items: center;
    border: 1px solid rgba(167, 138, 255, 0.24);
    border-radius: 99px;
    color: #c1b3fb;
    font-size: 0.48rem;
    text-transform: uppercase;
  }

  .paper-badge--accepted {
    border-color: rgba(81, 232, 185, 0.27);
    background: rgba(81, 232, 185, 0.05);
    color: #83e8c9;
  }

  .publication-copy h3 {
    max-width: 27ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.8vw, 2.25rem);
    letter-spacing: -0.045em;
    line-height: 1.16;
    overflow-wrap: anywhere;
  }

  .publication-authors {
    margin: 1.15rem 0;
    color: var(--text-soft);
    font-size: 0.74rem;
    line-height: 1.75;
  }

  .publication-authors .is-self {
    color: #d9ceff;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--card-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.23rem;
  }

  .publication-description {
    max-width: 48rem;
    margin: 0;
    color: var(--text-soft);
    font-size: 0.82rem;
    line-height: 1.82;
  }

  .publication-bottom {
    display: flex;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.7rem;
    align-items: flex-end;
    justify-content: space-between;
  }

  .publication-keywords {
    display: flex;
    flex-wrap: wrap;
    gap: 0.42rem;
  }

  .publication-keywords span {
    padding: 0.32rem 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 0.35rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.47rem;
  }

  .publication-links { display: flex; gap: 0.45rem; }
  .publication-links a {
    display: inline-flex;
    gap: 0.35rem;
    padding: 0.5rem 0.62rem;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 0.45rem;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 0.58rem;
    text-decoration: none;
  }

  @media (max-width: 820px) {
    .publication-card { grid-template-columns: 1fr; }
    .publication-visual { min-height: 18rem; border-right: 0; border-bottom: 1px solid var(--line); }
    .publication-visual svg { max-height: 15rem; }
  }

  @media (max-width: 480px) {
    .publication-visual { min-height: 14rem; }
    .publication-copy { padding: 1.25rem; }
    .publication-copy__meta { align-items: flex-start; }
    .publication-copy__meta > span:first-child { max-width: 65%; }
    .publication-bottom { display: block; }
    .publication-links { margin-top: 1rem; }
  }
</style>
